{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@a-multilayout-splitter/core": ["packages/core/src"],
      "@a-multilayout-splitter/core/*": ["packages/core/src/*"]
    }
  },
  "references": [
    {
      "path": "./packages/core"
    }
  ],
  "exclude": ["node_modules", "dist"]
}
